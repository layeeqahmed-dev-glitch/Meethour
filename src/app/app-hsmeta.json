{
  "uid": "meethour_app",
  "type": "app",
  "config": {
    "description": "Schedule and manage Meet Hour video meetings directly from HubSpot. Create meetings from contacts, deals, forms, and the HubSpot meeting scheduler, and keep every meeting logged on the CRM record.",
    "name": "Meet Hour",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://meethourhubs.vercel.app/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.owners.read",
        "crm.objects.deals.read",
        "crm.schemas.deals.write",
        "crm.objects.users.read",
        "forms",
        "automation",
        "crm.schemas.contacts.write",
        "crm.objects.appointments.read"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com",
        "https://meethourhubs.vercel.app"
      ],
      "iframe": [
        "https://meethourhubs.vercel.app"
      ],
      "img": []
    },
    "support": {
      "supportEmail": "hello@meethour.io",
      "documentationUrl": "https://example.io/",
      "supportUrl": "https://meethour.io/contact",
      "supportPhone": "+919876543210"
    }
  }
}